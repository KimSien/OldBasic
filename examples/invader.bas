10 REM invader.bas - スペースインベーダー
20 REM 操作: Z=左  X=右  スペース=発射
30 SCREEN 1
40 CLS
50 DIM IX(16)
60 DIM IY(16)
70 DIM IA(16)
80 DIM IC(16)
90 LET NI=15 : LET IW=14 : LET IH=8 : LET PY=178
100 REM --- インベーダー配置 ---
110 FOR I=1 TO NI
120   LET C=(I-1)-5*INT((I-1)/5)
130   LET R=INT((I-1)/5)
140   IX(I)=28+C*24
150   IY(I)=24+R*18
160   IA(I)=1
170   IC(I)=12-R*2
180 NEXT I
190 REM --- ゲーム変数 ---
200 LET PX=160 : LET LIVES=3 : LET SCORE=0 : LET RUNNING=1
210 LET BA=0 : LET BX=0 : LET BY=0
220 LET EA=0 : LET EX=0 : LET EY=0
230 LET IDX=2 : LET ITICK=0 : LET ISPEED=20
240 REM --- 背景・枠 ---
250 LINE (0,0)-(319,199),1,BF
260 LINE (0,0)-(319,199),8,B
270 LINE (0,186)-(319,186),8
280 REM --- 初期描画 ---
290 GOSUB 3000
300 GOSUB 3100
310 REM
320 REM ======= メインループ =======
330 REM
340 DO WHILE RUNNING=1
350   LET K$=INKEY$
360   REM -- プレイヤー消す --
370   LINE (PX-8,PY-9)-(PX+8,PY+1),1,BF
380   REM -- 移動 --
390   IF K$="z" THEN PX=PX-3
400   IF K$="x" THEN PX=PX+3
410   IF PX<9 THEN PX=9
420   IF PX>310 THEN PX=310
430   REM -- 発射 --
440   IF K$<>" " THEN GOTO 460
450   IF BA=0 THEN BA=1 : BX=PX : BY=PY-11
460   REM -- プレイヤー描画 --
470   LINE (PX-8,PY+1)-(PX+8,PY-1),14,BF
480   LINE (PX-5,PY-1)-(PX+5,PY-6),14,BF
490   LINE (PX-2,PY-6)-(PX+2,PY-9),14,BF
500   PSET (PX-6,PY-1),11
510   PSET (PX+6,PY-1),11
520   REM -- プレイヤー弾 --
530   IF BA=0 THEN GOTO 570
540   LINE (BX-1,BY)-(BX+1,BY+4),1,BF
550   BY=BY-6
560   IF BY>=2 THEN LINE (BX-1,BY)-(BX+1,BY+4),15,BF
565   IF BY<2 THEN BA=0
570   REM -- 弾 vs インベーダー --
580   IF BA=0 THEN GOTO 660
590   LET HIT=0
600   FOR I=1 TO NI
610     IF HIT=1 THEN GOTO 650
620     IF IA(I)=0 THEN GOTO 650
630     IF BX<IX(I) THEN GOTO 650
640     IF BX>IX(I)+IW THEN GOTO 650
641     IF BY+4<IY(I) THEN GOTO 650
642     IF BY>IY(I)+IH THEN GOTO 650
643     LINE (IX(I),IY(I))-(IX(I)+IW,IY(I)+IH),1,BF
644     IA(I)=0 : BA=0 : HIT=1
645     SCORE=SCORE+10
646     SOUND 600,2
650   NEXT I
655   IF HIT=0 THEN GOTO 670
656   ISPEED=20-4*INT(SCORE/50)
657   IF ISPEED<4 THEN ISPEED=4
660   REM
670   REM -- インベーダー移動 --
680   ITICK=ITICK+1
690   IF ITICK<ISPEED THEN GOTO 710
700   GOSUB 3200 : ITICK=0
710   REM -- 敵弾発射 --
720   IF EA<>0 THEN GOTO 740
730   IF INT(RND(1)*50)=0 THEN GOSUB 3600
740   REM -- 敵弾移動 --
750   IF EA=0 THEN GOTO 800
760   LINE (EX-1,EY)-(EX+1,EY+4),1,BF
770   EY=EY+4
780   IF EY>184 THEN EA=0 : GOTO 800
790   LINE (EX-1,EY)-(EX+1,EY+4),12,BF
800   REM -- 敵弾 vs プレイヤー --
810   IF EA=0 THEN GOTO 860
820   IF EX<PX-8 THEN GOTO 860
830   IF EX>PX+8 THEN GOTO 860
840   IF EY+4<PY-9 THEN GOTO 860
850   GOSUB 3700
860   REM -- 全滅チェック --
870   LET NALIVE=0
880   FOR I=1 TO NI
890     NALIVE=NALIVE+IA(I)
900   NEXT I
910   IF NALIVE=0 THEN RUNNING=2
920   REM -- 着地チェック --
930   FOR I=1 TO NI
940     IF IA(I)=1 AND IY(I)+IH>183 THEN RUNNING=0
950   NEXT I
960   REM -- スコア表示 --
970   GOSUB 3100
980   SLEEP 0.05
990 LOOP
1000 REM
1010 REM ===== ゲーム終了 =====
1020 IF RUNNING=2 THEN GOTO 1070
1030 REM GAME OVER
1040 LINE (55,88)-(265,112),4,BF
1050 LINE (55,88)-(265,112),15,B
1060 PRINT "*** GAME OVER ***  SCORE:";SCORE
1065 GOTO 1100
1070 REM YOU WIN
1080 LINE (55,88)-(265,112),2,BF
1090 LINE (55,88)-(265,112),15,B
1095 PRINT "*** YOU WIN! ***  SCORE:";SCORE
1100 END
1110 REM
1120 REM =================================
1130 REM  サブルーチン
1140 REM =================================
1150 REM
3000 REM インベーダー全描画
3010 FOR I=1 TO NI
3020   IF IA(I)=0 THEN GOTO 3060
3030   LINE (IX(I),IY(I))-(IX(I)+IW,IY(I)+IH),IC(I),BF
3040   PSET (IX(I)+3,IY(I)+2),1
3050   PSET (IX(I)+IW-3,IY(I)+2),1
3060 NEXT I
3070 RETURN
3100 REM ライフ・スコア表示エリア
3110 LINE (2,188)-(100,198),1,BF
3120 FOR L=1 TO LIVES
3130   LET LX=3+(L-1)*15
3140   LINE (LX,197)-(LX+10,195),14,BF
3150   LINE (LX+3,195)-(LX+7,192),14,BF
3160 NEXT L
3170 RETURN
3200 REM インベーダー移動
3210 LET DROP=0
3220 FOR I=1 TO NI
3230   IF IA(I)=0 THEN GOTO 3260
3240   IF IX(I)+IDX<2 THEN DROP=1
3250   IF IX(I)+IDX+IW>317 THEN DROP=1
3260 NEXT I
3270 FOR I=1 TO NI
3280   IF IA(I)=0 THEN GOTO 3310
3290   LINE (IX(I),IY(I))-(IX(I)+IW,IY(I)+IH),1,BF
3300   IF DROP=0 THEN IX(I)=IX(I)+IDX
3310 NEXT I
3320 IF DROP=1 THEN GOTO 3340
3330 GOTO 3380
3340 IDX=-IDX
3350 FOR I=1 TO NI
3360   IF IA(I)=1 THEN IY(I)=IY(I)+8
3370 NEXT I
3380 GOSUB 3000
3390 RETURN
3600 REM 敵弾発射
3610 LET SFOUND=0
3620 FOR I=1 TO NI
3630   IF SFOUND=1 THEN GOTO 3660
3640   IF IA(I)=0 THEN GOTO 3660
3650   IF INT(RND(1)*4)<>0 THEN GOTO 3660
3651   SFOUND=1 : EX=IX(I)+7 : EY=IY(I)+IH
3660 NEXT I
3670 IF SFOUND=1 THEN EA=1
3680 RETURN
3700 REM プレイヤー被弾
3710 LIVES=LIVES-1 : EA=0
3720 SOUND 120,8
3730 LINE (PX-10,PY-11)-(PX+10,PY+3),12,BF
3740 SLEEP 0.3
3750 LINE (PX-10,PY-11)-(PX+10,PY+3),1,BF
3760 IF LIVES<=0 THEN RUNNING=0
3770 RETURN
